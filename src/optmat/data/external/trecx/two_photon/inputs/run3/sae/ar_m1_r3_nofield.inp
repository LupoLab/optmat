 Rn,12,20.,40.,RpowL*polynomial,5
 Rn,12,40.,BOX,RpowL*polynomial,9
 Rn,30,BOX,Infty,polExp[0.5]

Absorption: kind, axis, theta, radius
ECS,Rn,0.3,BOX

Operator: hamiltonian=1/2<<Laplacian>>+<1><1><-TongLinV>
Operator: interaction='iLaserAz[t]<<D/DZ>>'
Operator: expectationValue='<1><1><chi[0,20]>,<1><1><chi[0,40]>,<1><1><chi[0,80]>'

# populations of the field-free (complex-scaled) eigenstates of H0, SmallReal order, 0-based
Occupation: states=0:70, operator=hamiltonian

Initial: state=2

# no Laser: field-free propagation over the same window (drift)

