# Text files are LF on every platform: the package hashes its configurations and stored
# records, and a CRLF checkout (git's default on Windows) would not match them.
* text=auto eol=lf

# Archived third-party files and calculation outputs are kept byte for byte, their line
# endings included (CXRO's and some run tables are CRLF): never converted.
src/optmat/data/external/** -text
